# Never commit a filled .env. Use Railway service variables in production.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
BOT_OWNER_ID=
PORT=8080
# Railway: attach volume at /data and set this path there.
DATABASE_PATH=data/mizan.sqlite3

# Financial integration is OFF until all four account owners configure and agree.
BEEMINDER_ENABLED=false
BEEMINDER_START_MONTH=2026-11
BEEMINDER_BINDINGS_JSON=[]
# Example (replace Discord IDs and usernames, then keep in Railway variables):
# [{"discord_id":123,"username":"alice","goal":"arabic-monthly","token_env":"BEE_ALICE","contract_verified":true}]
# BEE_ALICE=

# WUPHF is unavailable until Twilio is configured and each recipient opts in.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
WUPHF_CONTACTS_JSON={}
# Example: {"123456789":"PHONE_IHSAN"}
# PHONE_IHSAN=+1...
