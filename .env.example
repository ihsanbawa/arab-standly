# Never commit a filled .env. Use Railway service variables in production.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
BOT_OWNER_ID=
# Enable only after Server Members Intent is enabled in Discord Developer Portal.
WELCOME_ON_JOIN=false
# Optional explicit destination for live class activity.
CLASS_CHANNEL_ID=
PORT=8080
# Railway: attach volume at /data and set this path there.
DATABASE_PATH=data/mizan.sqlite3

# Financial integration is OFF until all four account owners configure and agree.
BEEMINDER_ENABLED=false
BEEMINDER_START_MONTH=2026-11
BEEMINDER_BINDINGS_JSON=[]
# Example (replace Discord IDs and usernames, then keep in Railway variables):
# [{"discord_id":123,"username":"alice","goal":"arabic-monthly","token_env":"BEE_ALICE","contract_verified":true}]
# BEE_ALICE=

# WUPHF (texts only) requires Twilio and private recipient mappings. Group permission is the default; /stopnudges stops texts.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
WUPHF_CONTACTS_JSON={}
# Example: {"123456789":"PHONE_IHSAN"}
# PHONE_IHSAN=+1...
# Optional: accept YES/NO/HERE text replies. Exact public URL configured in Twilio, e.g. https://<railway-domain>/twilio/sms
TWILIO_WEBHOOK_URL=
